# WhatsApp — international format without + or spaces (Nigeria: 234XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678

# UploadThing — get this from your UploadThing project dashboard under Settings > API Keys
UPLOADTHING_TOKEN=your-uploadthing-token

# Neon (Drizzle) — get from neon.tech project dashboard
# Use the POOLED connection string for application queries
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# UNPOOLED connection for migrations (drizzle-kit push/migrate, pg_restore)
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# better-auth — generate secret with `openssl rand -hex 32`
BETTER_AUTH_SECRET=replace-with-64-char-hex
BETTER_AUTH_URL=http://localhost:3000

# Resend — transactional email (admin + customer order notifications)
# Get your API key at resend.com/api-keys
# RESEND_FROM must be a verified sender address/domain in your Resend account
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Twinkle Locs <orders@twinklelocs.com>
# Where customer replies go (optional; defaults to hello@twinklelocs.com). Use an inbox someone reads.
EMAIL_REPLY_TO=hello@twinklelocs.com
# Delivery tracking (optional but recommended): in Resend → Webhooks, add
# https://twinklelocs.com/api/webhooks/resend for email.* events and paste the signing secret here.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Optional: signs newsletter unsubscribe links (falls back to BETTER_AUTH_SECRET)
# NEWSLETTER_SECRET=
# Admin access — comma-separated emails allowed to sign up / use /admin.
# Leave empty to allow only the very first account (first-run setup).
# Set it in production to lock out any accounts created before sign-up was closed.
ADMIN_EMAILS=

# Ad tracking (Meta + TikTok). All optional: leave a value unset and that part is off.
# With no pixel ID set there is no cookie banner and nothing is sent to Meta or TikTok.
# Pixels load only after a visitor presses Accept on the cookie banner.
# Meta: Events Manager > Data sources > your dataset (pixel) > Settings > "Dataset ID" (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (server-side Purchase): same Settings page > Conversions API > Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional, only while testing: Events Manager > your dataset > Test events tab (e.g. TEST12345). Remove when live.
META_TEST_EVENT_CODE=
# TikTok: Ads Manager > Tools > Events > Web events > your pixel > "Pixel ID" (letters and digits, e.g. C4ABC...)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# TikTok Events API (server-side CompletePayment): same pixel > Settings > Events API > Generate access token
TIKTOK_EVENTS_ACCESS_TOKEN=
# Optional, only while testing: your pixel > Test events tab. Remove when live.
TIKTOK_TEST_EVENT_CODE=
